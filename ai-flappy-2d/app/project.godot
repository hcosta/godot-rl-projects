; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AI Flappy 2D 4.5.1"
run/main_scene="uid://d3mpcjnnwre4u"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="uid://dpjuyqnr88xqh"

[autoload]

DebugHelper="*res://scripts/debug_helper.gd"

[display]

window/size/viewport_width=288
window/size/viewport_height=512
window/size/always_on_top=true
window/size/window_width_override=864
window/size/window_height_override=1536
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Flappy Bird IA 4-Steps"

[editor_plugins]

enabled=PackedStringArray("res://addons/drawn_area_2d/plugin.cfg", "res://addons/godot_rl_agents/plugin.cfg")

[input]

toggle_speed={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":84,"key_label":0,"unicode":116,"location":0,"echo":false,"script":null)
]
}

[rendering]

